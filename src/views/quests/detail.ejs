<%- include('../partials/header') %>

<main>
    <section class="card">
        <h1><%= quest.title %></h1>

        <p>
            <strong>Difficulty:</strong>
            <%= quest.difficulty %>
        </p>

        <p>
            <strong>Reward:</strong>
            <%= quest.reward %>
        </p>

        <p>
            <strong>Duration:</strong>
            <%= quest.duration_minutes %> minutes
        </p>

        <p>
            <strong>Party Size:</strong>
            <%= quest.max_party_size %>
        </p>

        <hr>

        <p>
            <%= quest.description %>
        </p>

        <% if (user) { %>
            <form method="POST" action="/quests/<%= quest.id %>/request">
                <button type="submit">
                    Request Quest
                </button>
            </form>
        <% } %>

        <% if (user && (user.role_name === "admin" || user.role_name === "staff")) { %>

            <p>
                <a href="/quests/<%= quest.id %>/edit" class="button">
                    Edit Quest
                </a>
            </p>

            <form method="POST" action="/quests/<%= quest.id %>/delete">
                <button type="submit">
                    Delete Quest
                </button>
            </form>

        <% } %>

        <p>
            <a href="/quests">← Return to Quest Board</a>
        </p>
    </section>
</main>

<%- include('../partials/footer') %>