<%- include('../partials/header') %>

<main>
    <h1>Manage Guild Members</h1>

    <% if (users && users.length > 0) { %>
        <% users.forEach(member => { %>
            <section class="card">
                <h2><%= member.name %></h2>

                <p><strong>Email:</strong> <%= member.email %></p>
                <p><strong>Current Role:</strong> <%= member.role_name %></p>

                <form method="POST" action="/admin/users/<%= member.id %>/role">
                    <label for="role-<%= member.id %>">Change Role</label>

                    <select id="role-<%= member.id %>" name="role" required>
                        <option value="user" <%= member.role_name === "user" ? "selected" : "" %>>User</option>
                        <option value="staff" <%= member.role_name === "staff" ? "selected" : "" %>>Staff</option>
                        <option value="admin" <%= member.role_name === "admin" ? "selected" : "" %>>Admin</option>
                    </select>

                    <button type="submit">Update Role</button>
                </form>
            </section>
        <% }) %>
    <% } else { %>
        <section class="card">
            <p>No guild members found.</p>
        </section>
    <% } %>
</main>

<%- include('../partials/footer') %>