<%- include('../partials/header') %>

<main>
    <h1>Manage Quest Requests</h1>

    <% if (requests && requests.length > 0) { %>
        <% requests.forEach(request => { %>
            <section class="card">
                <h2><%= request.quest_title %></h2>

                <p><strong>Guild Member:</strong> <%= request.user_name %></p>
                <p><strong>Email:</strong> <%= request.user_email %></p>
                <p><strong>Status:</strong> <%= request.status %></p>
                <p><strong>Difficulty:</strong> <%= request.difficulty %></p>

                <form method="POST" action="/requests/<%= request.id %>/status">
                    <select name="status" required>
                        <% statuses.forEach(status => { %>
                            <option value="<%= status %>" <%= request.status === status ? "selected" : "" %>>
                                <%= status %>
                            </option>
                        <% }) %>
                    </select>

                    <button type="submit">Update Status</button>
                </form>
            </section>
        <% }) %>
    <% } else { %>
        <section class="card">
            <p>No quest requests yet.</p>
        </section>
    <% } %>
</main>

<%- include('../partials/footer') %>
